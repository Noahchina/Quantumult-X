# 重写规则配置片段包含若干条重写规则，并可以包含若干作用于 MitM 的主机名及分流规则；可通过资源引用的方式使用。
# 片段文件将保存在 Quantumult X 目录下的 Profiles 子目录中。
# 样例可参见 https://raw.githubusercontent.com/crossutility/Quantumult-X/master/sample-import-rewrite.snippet
 
 
 
;^http://example.com/resource1/4/ url reject-dict
[filter_local]
# 秦链接技（qinlinkeji）系列广告域名直接拒绝
hostname = mall-dsp2.qinlinkeji.com, mallapi2.qinlinkeji.com

# qadx.qinlinad.com 的 /ad/ 路径直接 reject
^https?://qadx\.qinlinad\.com/ad/ - reject

[mitm]
# 需要启用 TLS 解密的域名
mitm = mall-dsp2.qinlinkeji.com, mallapi2.qinlinkeji.com, qadx.qinlinad.com